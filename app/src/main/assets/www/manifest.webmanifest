{
  "id": "./",
  "name": "WebyPDF – All-in-One PDF Tools",
  "short_name": "WebyPDF",
  "description": "Merge, split, compress, sign and convert PDFs privately in your browser. Works offline.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#150d3a",
  "theme_color": "#7c3aed",
  "lang": "en",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Merge PDF", "url": "./#/merge", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compress PDF", "url": "./#/compress", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Split PDF", "url": "./#/split", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Images to PDF", "url": "./#/images-to-pdf", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
